{
  "name": "daily-kanban",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "vercel:link": "vercel link",
    "vercel:pull": "vercel env pull .env.local",
    "vercel:build": "vercel build",
    "vercel:deploy": "vercel deploy --prebuilt",
    "supabase:link": "supabase link",
    "supabase:types": "supabase gen types typescript --local > src/types/supabase.ts",
    "supabase:db:lint": "supabase db lint"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.1.0",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.6",
    "supabase": "^2.118.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vercel": "^60.1.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
